# Flutter SDK checked out into the repo for local development (not versioned).
flutter/

# Dart / pub workspace
.dart_tool/
.packages

# Build output
build/
# The NDK's CMake working directory, written beside the vendored fork's sources when an Android
# build configures its native library. Generated, machine-specific, and regenerated on demand.
.cxx/
# The Kotlin compiler's session files, written while an Android build runs.
.kotlin/

# IDE
*.iml
*.ipr
*.iws
.idea/

# Editor and assistant settings that belong to one machine, not to the project.
.vscode/
.claude/settings.local.json
.claude/worktrees/

# Misc
*.log
.DS_Store

# The repository signing key (ADR-0018). Private: whoever has it can sign packages as this
# repository, so it stays on the machine that builds the repository and never in the history.
repository-signing-key.txt

# The Android release keystore and the file that points at it (ADR-0010). Whoever has both can
# publish an APK that Android will install over a real one, so neither goes near the history. CI
# writes key.properties from secrets and deletes the keystore with the runner.
app/android/key.properties
*.jks
*.keystore
