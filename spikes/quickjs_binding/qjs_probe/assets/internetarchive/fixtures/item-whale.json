":"whale_weekly_poem_1610_jp2.zip","source":"derivative","format":"Single Page Processed JP2 ZIP","original":"whale_weekly_poem_1610.pdf","mtime":"1476209085","size":"935669","md5":"27ab30902837959e3ae5683998ad4600","crc32":"8c2b14d9","sha1":"0174de887ea09ceadf62dd4bab4b6f3831189d04","filecount":"1"},{"name":"whale_weekly_poem_1610_page_numbers.json","source":"derivative","format":"Page Numbers JSON","original":"whale_weekly_poem_1610_djvu.xml","mtime":"1642786250","size":"139","md5":"09a7bf5099ab4362a8b3cf98ce9821f2","crc32":"abb7a007","sha1":"334e09f01ffebfa121f2c4d2497a4bdce504f75c"},{"name":"whale_weekly_poem_1610_scandata.xml","source":"derivative","format":"Scandata","original":"whale_weekly_poem_1610_djvu.xml","mtime":"1642786247","size":"538","md5":"c7c9a8ff5c9420aef75242906f777534","crc32":"e17572c8","sha1":"f7132584ac608e7bd0f22fc4a1e3bf60cea7b885"},{"name":"whale_weekly_poem_1610_thumb.jpg","source":"original","format":"JPEG Thumb","rotation":"0","mtime":"1476208093","size":"14100","md5":"c9718747f6ecce0c92c01461b382cbb6","crc32":"76ccc06c","sha1":"c60505b58a3635f6233d30816bd0291bf922d9ad"}],"files_count":112,"item_last_updated":1775176384,"item_size":65976287,"metadata":{"identifier":"the_whale_1610.poem_librivox","creator":"Ellis Parker Butler","date":"2016-10-09","description":"<a href=\"http://librivox.org/\" rel=\"ugc nofollow\">LibriVox</a> volunteers bring you 15 recordings of The Whale by Ellis Parker Butler. \nThis was the Weekly Poetry project for October 2, 2016.\n\nRead in English by Bruce Kachuk; Beth Thomas; Corbs; David Lawrence; Ezwa; Garth Burton; Greg Giordano; Lee Ann Howlett; Leonard Wilson; Kopikido; Maria Kasper; Matthew Datcher; RTaylor; Tomas Peter and tovarisch.\n\nHis career spanned more than forty years, and his stories, poems, and articles were published in more than 225 magazines. His work appeared alongside that of his contemporaries, including Mark Twain, Sax Rohmer, James B. Hendryx, Berton Braley, F. Scott Fitzgerald, Don Marquis, Will Rogers, and Edgar Rice Burroughs.\n\nDespite the enormous volume of his work, Butler was, for most of his life, only a part-time author. He worked full-time as a banker and was very active in his local community. A founding member of both the Dutch Treat Club and the Authors League of America, Butler was an always-present force in the New York City literary scene. ( Wikipedia)\n\nFor further information, including links to online text, reader information, RSS feeds, CD cover or other formats (if available), please go to the <a href=\"https://librivox.org/the-whale-by-ellis-parker-butler/\" rel=\"ugc nofollow\">LibriVox catalog page</a> for this recording. \n\nFor more free audio books or to become a volunteer reader, visit <a href=\"http://librivox.org/\" rel=\"ugc nofollow\">LibriVox.org</a>.\n\n<a href=\"https://archive.org/download/the_whale_1610.poem_librivox/the_whale_1610.poem_librivox.m4b\" rel=\"ugc nofollow\">M4B Audiobook (8MB)</a>","licenseurl":"http://creativecommons.org/publicdomain/mark/1.0/","mediatype":"audio","subject":"librivox; audiobooks; literature; poetry; satire; humor; nature; dairy; milking; whales","title":"The Whale","collection":["librivoxaudio","audio_bookspoetry"],"publicdate":"2016-10-09 11:12:20","uploader":"info@librivox.org","addeddate":"2016-10-09 11:12:20","year":"2016","ppi":"600","ocr":"ABBYY FineReader 11.0","runtime":"17:59","backup_location":"ia906208_14","external_metadata_update":"2019-04-05T09:02:48Z","ocr_module_version":"0.0.14","ocr_converted":"abbyy-to-hocr 1.1.11","call_number":"11346","language":"eng","external-identifier":"urn:storj:bucket:jvrrslrv7u4ubxymktudgzt3hnpq:the_whale_1610.poem_librivox","filesxml":"Fri Apr 3 0:33:00 UTC 2026"},"reviews":[{"reviewbody":"    The Whale is found in seas and oceans,\n    Indulging there in fishlike motions,\n    But Science shows that Whales are mammals,\n    Like Jersey cows, and goats, and camels.\n\n    When undisturbed, the Whale will browse\n    Like camels, goats, and Jersey cows,\n    On food that satisfies its tongue,\n    Thus making milk to feed its young.\n\n    Asking no costly hay and oats,\n    Like camels, Jersey cows, and goats,\n    The Whale, prolific milk producer,\n    Should be our cheapest lactic juicer.\n\n    Our milk should all come from the sea,\n    But who, I ask, would want to be,\n    And here the proposition fails,\n    The milkmaid to a herd of Whales?","reviewtitle":"text of this poem below:","reviewer":"Basquetteur","reviewdate":"2017-01-09 11:30:31","createdate":"2017-01-09 11:30:31","stars":"4"}],"server":"ia800508.us.archive.org","uniq":1173032939,"workable_servers":["ia800508.us.archive.org","ia600508.us.archive.org"]}